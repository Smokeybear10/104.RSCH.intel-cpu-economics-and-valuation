  "method": {
    "formula": "(Revenue_end \u2212 Revenue_start) / SUM_over_intervening_years(cash PP&E + cash acquired intangibles \u2212 PP&E/intangible sale proceeds + lease principal \u2212 depreciation \u2212 amortization + operating WC investment).",
    "trade_WC": "Negative sum of cash-flow changes in ordinary and related receivables, inventories, and ordinary and related trade payables. These CFO changes avoid most noncash balance-sheet translation effects.",
    "broad_WC": "Trade WC plus selected other operating asset and liability changes; excludes financial assets, derivatives, pensions and taxes. Includes customer advances inside accrued/other liabilities. Broad scope is less clean than trade scope.",
    "trade_cash_changes_order": [
      "accounts_and_notes_receivable",
      "related_receivable",
      "inventory",
      "accounts_payable",
      "related_payable"
    ],
    "other_operating_cash_changes_order_2021_2022": [
      "other_related_receivable",
      "other_current_assets",
      "salary_bonus",
      "profit_sharing_bonus",
      "accrued_other_current_liabilities",
      "other_noncurrent_liabilities"
    ],
    "other_operating_cash_changes_order_2023_2025": [
      "other_related_receivable",
      "other_current_assets",
      "other_noncurrent_assets",
      "salary_bonus",
      "profit_sharing_bonus",
      "accrued_other_current_liabilities",
      "other_noncurrent_liabilities"
    ],
    "other_noncurrent_assets_early_years": "No separate other noncurrent asset line in the 2022 cash-flow statement; not asserted economically zero. This is one limit of broad cross-period scope.",
    "capitalized_interest": "PP&E cash payments already exclude capitalized interest in Note 31/32 reconciliations; do not subtract it again. Interest paid is financing. D&A still reflects historical capitalized interest, a remaining small mismatch.",
    "grants": "Use gross PP&E cash acquisitions, with no deduction for government PPE receipts or minority equity funding; comparable to operating reinvestment before financing. Grant accounting can reduce future reported D&A, so gross economic depreciation is not identified perfectly.",
    "leases": "Includes lease principal to counter D&A on right-of-use assets; lease prepayment sensitivity shown separately. Debt principal, dividends and financing proceeds excluded.",
    "time_alignment": "Start-year revenue is the baseline; investment only in following years through end-year. This deliberately avoids mixing stock PP&E or one-quarter annualization with incremental cash investment."
  },
