    "lambda": "Fraction of direct cost savings passed through into task price.",
    "epsilon": "Absolute task-demand price elasticity.",
    "a": "Additional task-demand multiplier due to latency, reliability or quality improvements, independent of price.",
    "h": "Multiplier for CPU useful work per purchased socket from hardware throughput and occupancy.",
    "s": "Intel share multiplier of purchased CPU units.",
    "p": "Intel average selling price multiplier.",
