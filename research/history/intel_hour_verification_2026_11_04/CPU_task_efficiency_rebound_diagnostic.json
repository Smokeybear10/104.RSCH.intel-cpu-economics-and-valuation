    "task_price_ratio": "1 - lambda*k*(1-f)",
    "task_quantity_ratio": "a * task_price_ratio**(-epsilon)",
    "CPU_work_demand_ratio": "f * task_quantity_ratio",
    "Intel_units_ratio": "CPU_work_demand_ratio / h * s",
    "Intel_revenue_ratio": "Intel_units_ratio * p",
    "price_only_rebound_threshold": "epsilon_star = ln(f)/ln(task_price_ratio), with a=h=s=p=1; if no price decline there is no finite price-only rebound threshold.",
    "quality_rebound_threshold": "a_star = 1 / (f * task_price_ratio**(-epsilon)) before hardware/share/ASP effects.",
    "general_task_price_ratio": "1 - lambda*(k*(1-f) + gamma), with total savings fraction between 0 and 1. Numeric grid sets gamma=0; it therefore isolates direct CPU cost pass-through."
