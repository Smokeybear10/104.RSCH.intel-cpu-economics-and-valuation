{
  "title": "Intel server ASP and product mix: prospective operating policy before new valuation",
  "frozen_utc": "2026-11-04T17:20:03.148471+00:00",
  "scope": "One additive host operating forecast. No equity value calculated or new equity output inspected. Existing policies and engines preserved. External packaging remains a separate, unchanged overlay.",
  "chronology": {
    "known_before_choice": "Prior base and funded-bull values and the 19.1667% revenue-offset diagnostic were known. The newly paired 20%-unit/0.80-turnover equity output was not opened or inspected. The 35% provisional incremental retention was challenged against the primary Q3 profit bridge and revised to 50% before valuation.",
    "selection": "20% ASP is a forward judgment from richer mix, 2026 price-level persistence and the 2027 product ramp; it is not fitted to an equity target or claimed to be inferred from exact quarterly unit counts."
  },
  "owned_judgment": {
    "preferred_server_ASP_growth_2027_2030": [
      0.2,
