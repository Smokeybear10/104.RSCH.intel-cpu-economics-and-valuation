      "conditional_Q3_ASP_over_YTD_ASP_min": 0.9814104330331833,
      "conditional_Q3_ASP_over_YTD_ASP_max": 2.8896671822745237,
      "use": "Shows why an exact measured carryover credit is inadmissible; these wide numbers are not a forecast or confidence interval."
    },
    "revenue_offset_diagnostic": {
      "formula": "(1.30*1.10)/1.20 -1",
      "required_ASP_growth": 0.19166666666666687,
      "meaning": "19.1667% restores the old30%-unit/10%-ASP2027 server-revenue factor. It does not restore the same physical bill of materials, costs or profits and was known before this judgment."
